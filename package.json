{
  "name": "maintenance_app_beta",
  "private": true,
  "version": "2.0.1",
  "description": "تطبيق إدارة مراكز صيانة الهواتف والأجهزة الإلكترونية",
  "author": "Maintenance App Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env VITE_APP_ENV=development vite",
    "build": "vite build",
    "test": "tsx test_sqlite_suite.ts",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/postinstall.js",
    "electron:build": "npm run build && electron-builder",
    "build:windows": "npm run build && electron-builder --win",
    "build:dev": "cross-env VITE_APP_ENV=development npm run build && electron-builder --win -c electron-builder-dev.json",
    "lint": "oxlint --ignore-pattern dist-electron/**",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.31.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.maintenance.app.beta",
    "productName": "Maintenance App Beta",
    "directories": {
      "output": "release_final2"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "default_seed.json"
    ]
  }
}
